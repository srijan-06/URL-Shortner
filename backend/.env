# ── Server ─────────────────────────────────────────────
PORT=4000
# Public base used to build the returned short URL, e.g. https://sho.rt
# In local dev this is just the API origin.
BASE_URL=http://localhost:4000

# ── PostgreSQL ─────────────────────────────────────────
# Either provide a full connection string (Supabase/Render give you one)…
DATABASE_URL=postgres://postgres:postgres@localhost:5432/urlshortener
# …or the discrete parts (used only if DATABASE_URL is empty).
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=urlshortener
# Set to "true" for managed providers that require TLS (Supabase, Render, etc.)
PGSSL=false

# ── Redis ──────────────────────────────────────────────
# Upstash gives you a rediss:// URL. Locally this points at the compose service.
REDIS_URL=redis://localhost:6379

# ── Rate limiter (token bucket) ────────────────────────
# Bucket capacity = max burst. Refill rate = sustained requests/second.
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_PER_SEC=5

# ── Caching ────────────────────────────────────────────
# TTL (seconds) for cached redirects that have no explicit expiry.
CACHE_TTL_SECONDS=3600

# ── CORS ───────────────────────────────────────────────
# Comma-separated allowed origins for the frontend. "*" allows all.
CORS_ORIGIN=*
